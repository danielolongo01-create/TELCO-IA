# Backend / Ollama
OLLAMA_URL=http://localhost:11434/api/chat
OLLAMA_MODEL=qwen2.5

# Termux: ces valeurs sont utilisées comme référence lors de la configuration de la sonde.
# Ne mettez PAS une IP publique : utilisez l'IP locale du PC sur le même Wi-Fi/hotspot.
SERVER=http://192.168.1.100:8000/api/v1/telemetry/ingest
CELL_ID=0x1A2B3
SOURCE=probe-01
INTERVAL_S=3
PING_TARGET=8.8.8.8
